# Ambiente
NODE_ENV=production
PORT=3333

# Banco PostgreSQL
DATABASE_URL=postgres://crm:TROQUE_A_SENHA@localhost:5432/crm_carrefour

# Login: desativado por padrão (acesso livre). Use true para exigir usuário e senha.
AUTH_ENABLED=false

# Segredo de assinatura das sessões (obrigatório com AUTH_ENABLED=true) (gere com: openssl rand -hex 32)
JWT_SECRET=
SESSION_HOURS=10

# Os arquivos originais ficam no próprio banco (tabela import_files, compactados).
MAX_UPLOAD_MB=300

# Código da assessoria esperado na nomenclatura (ex.: LEALCO). Vazio = não valida.
AGENCY_CODE=LEALCO

# Primeiro acesso (opcional): cria o administrador se o banco não tiver usuários.
# Remova ADMIN_PASSWORD depois do primeiro login.
ADMIN_USERNAME=admin
ADMIN_NAME=Administrador
ADMIN_PASSWORD=

# Integração API SIC (somente leitura). Não versione valores reais: configure no painel da Vercel.
SIC_API_URL=
SIC_USUARIO=
SIC_SENHA=
# Servidor do SIC usado nas rotas /{server}/... (informado pelo responsável pela API)
SIC_SERVER=
