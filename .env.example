# Ambiente
NODE_ENV=production
PORT=3333

# Banco PostgreSQL
DATABASE_URL=postgres://crm:TROQUE_A_SENHA@localhost:5432/crm_carrefour

# Segredo de assinatura das sessões (gere com: openssl rand -hex 32)
JWT_SECRET=
SESSION_HOURS=10

# Diretório onde os arquivos originais são guardados para auditoria
STORAGE_DIR=./storage
MAX_UPLOAD_MB=300

# Código da assessoria esperado na nomenclatura (ex.: LEALCO). Vazio = não valida.
AGENCY_CODE=LEALCO

# Primeiro acesso (opcional): cria o administrador se o banco não tiver usuários.
# Remova ADMIN_PASSWORD depois do primeiro login.
ADMIN_USERNAME=admin
ADMIN_NAME=Administrador
ADMIN_PASSWORD=
